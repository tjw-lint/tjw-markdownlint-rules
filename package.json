{
  "name": "tjw-markdownlint-rules",
  "version": "1.2.0",
  "description": "The Jared Wilcurt's Markdown linting rules",
  "main": "index.js",
  "scripts": {
    "validate": "npm run lint && npm test",
    "test": "node test.js",
    "lint": "markdownlint -i \"./node_modules/**/*\" --config ./tjwmarkdownlint.yml README.md"
  },
  "devDependencies": {
    "markdownlint": "^0.42.0",
    "markdownlint-cli": "^0.50.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheJaredWilcurt/tjw-markdownlint-rules.git"
  },
  "keywords": [
    "markdown",
    "lint",
    "markdownlint",
    "linting",
    "rules",
    "md"
  ],
  "author": "The Jared Wilcurt",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheJaredWilcurt/tjw-markdownlint-rules/issues"
  },
  "homepage": "https://github.com/TheJaredWilcurt/tjw-markdownlint-rules#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2"
    }
  }
}
